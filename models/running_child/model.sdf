<?xml version="1.0"?>
<sdf version="1.6">
  <model name="running_child">
    <!-- Static false allows movement / physics forces or programmatic pose update -->
    <static>false</static>
    <link name="child_body">
      <inertial>
        <mass>15.0</mass>
        <inertia>
          <ixx>0.2</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.2</iyy>
          <iyz>0.0</iyz>
          <izz>0.1</izz>
        </inertia>
      </inertial>

      <!-- Torso / Clothes (Bright yellow/orange shirt for visibility) -->
      <visual name="torso_visual">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.5</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.0 0.5 0.0 1.0</ambient>
          <diffuse>1.0 0.5 0.0 1.0</diffuse>
        </material>
      </visual>
      <collision name="torso_collision">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.5</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- Head -->
      <visual name="head_visual">
        <pose>0 0 0.8 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.12</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.9 0.75 0.65 1.0</ambient>
          <diffuse>0.9 0.75 0.65 1.0</diffuse>
        </material>
      </visual>
      <collision name="head_collision">
        <pose>0 0 0.8 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.12</radius>
          </sphere>
        </geometry>
      </collision>

      <!-- Legs / Base -->
      <visual name="legs_visual">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.2</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.2 0.7 1.0</ambient>
          <diffuse>0.1 0.2 0.7 1.0</diffuse>
        </material>
      </visual>
      <collision name="legs_collision">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.2</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
